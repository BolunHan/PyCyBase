# DISABLED (temporary) — do NOT re-enable.
# GitHub Actions workflows are disabled for this repository until the
# GitHub Actions issue is resolved. See .github/workflows/README.md.
# Re-enable: git mv .github/workflows/publish-nt-to-pypi.yml.disabled .github/workflows/publish-nt-to-pypi.yml
# ============================================================================
name: PyPI (Windows)

on:
    push:
        tags:
            - "v*.*.*"
    workflow_dispatch: # Allow manual run on latest commit

jobs:
    build:
        runs-on: windows-latest

        steps:
            -   name: Checkout repository
                uses: actions/checkout@main

            -   name: Set up Python
                uses: actions/setup-python@main
                with:
                    python-version: "3.x"

            -   name: Install cibuildwheel
                run: python -m pip install --upgrade cibuildwheel

            -   name: Install dependencies
                env:
                    GITHUB_ACTIONS: "true"
                run: |
                    pip install --upgrade pip setuptools wheel
                    pip install -r requirements.txt

            -   name: Build wheels
                run: |
                    python -m cibuildwheel --output-dir wheelhouse
                env:
                    CIBW_SKIP: "pp*" # Skip PyPy
                    CIBW_BUILD: "cp3*-win_amd64"
                    CIBW_BEFORE_BUILD: "if exist build rmdir /s /q build"
                    CIBW_ENVIRONMENT: "GITHUB_ACTIONS=true"

            -   name: Publish to PyPI
                env:
                    TWINE_USERNAME: "__token__"
                    TWINE_PASSWORD: ${{ secrets.PYPI_TOKEN }}
                run: |
                    pip install twine
                    twine upload wheelhouse/*
